# Copy to .env and fill in. Do NOT commit .env.

# TypeSafe / JEV early access key (client reads TYPESAFE_API_KEY, model defaults to jev-latest)
TYPESAFE_API_KEY=

# Gemini API key from Google AI Studio (free tier is plenty for 30 alerts)
GEMINI_API_KEY=

# Optional: override the Gemini model. Use a *Flash* tier for a fair apples-to-apples
# comparison against a lightweight decision model (not Pro).
GEMINI_MODEL=gemini-2.5-flash
