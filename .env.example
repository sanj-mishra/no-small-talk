# Copy to .env and fill in. Do NOT commit .env.

# TypeSafe / JEV early access key (client reads TYPESAFE_API_KEY, model defaults to jev-latest)
TYPESAFE_API_KEY=

# Gemini API key from Google AI Studio (free tier works; calls are paced to stay under the rate limit)
GEMINI_API_KEY=

# Optional: override the Gemini model. Use a *Flash* tier for a fair apples-to-apples
# comparison against a lightweight decision model (not Pro).
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: seconds between Gemini calls, to stay under the per-minute quota (default 4.0).
# GEMINI_MIN_INTERVAL_S=4.0
